@model ClinicSystem.Models.ConsultationRecord
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Consultation Record";
}

<h2>Consultation Record</h2>
<div class="card"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@(Model.Appointment?.Patient?.FullName)</dd>
        <dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">@(Model.Appointment?.Doctor?.FullName)</dd>
        <dt class="col-sm-3">Consultation Date</dt><dd class="col-sm-9">@Model.ConsultationDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Diagnosis</dt><dd class="col-sm-9">@Model.Diagnosis</dd>
        <dt class="col-sm-3">Treatment Notes</dt><dd class="col-sm-9">@Model.TreatmentNotes</dd>
    </dl>
</div></div>

<div class="mt-3">
    @if (User.IsInRole("Doctor"))
    {
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.RecordId">Edit</a>
    }
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
