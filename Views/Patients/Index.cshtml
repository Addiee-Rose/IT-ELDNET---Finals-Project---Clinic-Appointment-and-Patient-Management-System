@model IEnumerable<ClinicSystem.Models.Patient>
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Patients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Patients</h2>
    <a class="btn btn-primary" asp-action="Create">+ Add Patient</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a class="btn btn-link" asp-action="Index">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
        <tr><th>Full Name</th><th>Birth Date</th><th>Gender</th><th>Contact</th><th>Address</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
            <td>@item.Gender</td>
            <td>@item.ContactNumber</td>
            <td>@item.Address</td>
            <td class="text-end">
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.PatientId">Details</a>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.PatientId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.PatientId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No patients found.</p>
}
