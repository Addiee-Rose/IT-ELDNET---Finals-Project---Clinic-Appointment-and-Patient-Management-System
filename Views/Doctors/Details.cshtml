@model ClinicSystem.Models.Doctor
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Doctor Details";
}

<h2>Doctor Details</h2>
<div class="card"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Full Name</dt><dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Specialization</dt><dd class="col-sm-9">@Model.Specialization</dd>
        <dt class="col-sm-3">Available Days</dt><dd class="col-sm-9">@Model.AvailableDays</dd>
        <dt class="col-sm-3">Hours</dt><dd class="col-sm-9">@(Model.StartTime.ToString("hh\\:mm")) - @(Model.EndTime.ToString("hh\\:mm"))</dd>
        <dt class="col-sm-3">Login Email</dt><dd class="col-sm-9">@(Model.User?.Email)</dd>
    </dl>
</div></div>

<div class="mt-3">
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.DoctorId">Edit</a>
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
