@model IEnumerable<ClinicSystem.Models.Doctor>
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Doctors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Doctors</h2>
    <a class="btn btn-primary" asp-action="Create">+ Add Doctor</a>
</div>

<table class="table table-striped table-hover bg-white">
    <thead class="table-dark">
        <tr><th>Full Name</th><th>Specialization</th><th>Available Days</th><th>Hours</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Specialization</td>
            <td>@item.AvailableDays</td>
            <td>@(item.StartTime.ToString("hh\\:mm")) - @(item.EndTime.ToString("hh\\:mm"))</td>
            <td class="text-end">
                <a class="btn btn-sm btn-info" asp-action="Details" asp-route-id="@item.DoctorId">Details</a>
                <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@item.DoctorId">Edit</a>
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.DoctorId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No doctors found.</p>
}
