@model ClinicSystem.ViewModels.RequestAppointmentViewModel
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Request Appointment";
}

<h2>Request Appointment</h2>
<div class="row"><div class="col-md-7">
<div class="card"><div class="card-body">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="DoctorId" class="form-label"></label>
        <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-select">
            <option value="0">-- Choose a doctor --</option>
        </select>
        <span asp-validation-for="DoctorId" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="AppointmentDate" class="form-label"></label>
            <input asp-for="AppointmentDate" type="date" class="form-control" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label for="AppointmentTime" class="form-label">Time</label>
            <input type="time" id="AppointmentTime" name="AppointmentTime" class="form-control" value="@(Model.AppointmentTime.ToString("hh\\:mm"))" />
            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Send Request</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
</div></div>
</div></div>
