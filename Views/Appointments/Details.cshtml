@model ClinicSystem.Models.Appointment
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Appointment Details";
}

<h2>Appointment Details</h2>
<div class="card"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@(Model.Patient?.FullName)</dd>
        <dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">@(Model.Doctor?.FullName) (@(Model.Doctor?.Specialization))</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.AppointmentDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Time</dt><dd class="col-sm-9">@(Model.AppointmentTime.ToString("hh\\:mm"))</dd>
        <dt class="col-sm-3">Reason</dt><dd class="col-sm-9">@Model.Reason</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><partial name="_StarterStatusBadge" model="Model.Status" /></dd>
    </dl>
</div></div>

@if (Model.ConsultationRecord != null)
{
    <div class="mt-3">
        <a class="btn btn-primary" asp-controller="ConsultationRecords" asp-action="Details" asp-route-id="@Model.ConsultationRecord.RecordId">View Consultation Record</a>
    </div>
}

<div class="mt-3">
    <a class="btn btn-secondary" asp-action="Index">Back to List</a>
</div>
