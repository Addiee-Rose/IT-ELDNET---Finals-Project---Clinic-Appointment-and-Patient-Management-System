@model ClinicSystem.Models.Appointment
@{
    Layout = "_StarterLayout";
    ViewData["Title"] = "Cancel Appointment";
}

<h2>Cancel Appointment</h2>
<div class="alert alert-warning">Are you sure you want to cancel this appointment?</div>

<div class="card mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Patient</dt><dd class="col-sm-9">@(Model.Patient?.FullName)</dd>
        <dt class="col-sm-3">Doctor</dt><dd class="col-sm-9">@(Model.Doctor?.FullName)</dd>
        <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.AppointmentDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Time</dt><dd class="col-sm-9">@(Model.AppointmentTime.ToString("hh\\:mm"))</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><partial name="_StarterStatusBadge" model="Model.Status" /></dd>
    </dl>
</div></div>

<form asp-action="Cancel" method="post">
    <input type="hidden" name="id" value="@Model.AppointmentId" />
    <button type="submit" class="btn btn-danger">Yes, cancel it</button>
    <a class="btn btn-secondary" asp-action="Index">Go back</a>
</form>
