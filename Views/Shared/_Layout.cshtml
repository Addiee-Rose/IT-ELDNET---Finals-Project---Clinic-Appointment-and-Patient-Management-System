<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Clinic System (starter)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body class="bg-body-tertiary">

<nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
    <div class="container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">Clinic System</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto">

                @if (User.IsInRole("Staff"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">Appointments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="Index">Patients</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index">Doctors</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ConsultationRecords" asp-action="Index">Consultation Records</a></li>
                }
                @if (User.IsInRole("Doctor"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">My Appointments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="MySchedule">My Schedule</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ConsultationRecords" asp-action="Index">Consultation Records</a></li>
                }
                @if (User.IsInRole("Patient"))
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">My Appointments</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Create">Request Appointment</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Patients" asp-action="MyInformation">My Information</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="ConsultationRecords" asp-action="Index">My Records</a></li>
                }

                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">About</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a></li>
            </ul>

            <div class="d-flex align-items-center text-white">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="me-3">Welcome, <strong>@User.Identity.Name</strong> (@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value))</span>

                    @* Logout MUST be a POST form (it needs the anti-forgery token) *@
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-light">Logout</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">Login</a>
                }
            </div>
        </div>
    </div>
</nav>

<main class="container pb-5">

    @* Messages sent by the controllers with TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @RenderBody()
</main>

<footer class="text-center text-muted small pb-4">
    Clinic Appointment and Patient Management System - starter views for back-end testing
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
